{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stretchu program",
  "description": "A list of exercise ids from the catalog (Resources/Exercises/catalog.json). Unknown ids are ignored by the app; settings outside the ranges are clamped.",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "exercises"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 90
        },
        "step1Seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 120
        },
        "step2Seconds": {
          "type": "integer",
          "minimum": 15,
          "maximum": 180
        }
      }
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "equipment": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "bands",
          "foam roll",
          "exercise ball",
          "medicine ball",
          "kettlebells",
          "dumbbell"
        ]
      }
    }
  }
}
